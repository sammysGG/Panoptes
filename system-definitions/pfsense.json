{
  "id": "pfsense",
  "name": "pfSense Firewall",
  "description": "pfSense / Netgate (FreeBSD) perimeter firewall, managed over SSH or the web UI.",
  "channel": "ssh",
  "icon": "firewall",
  "match": {
    "anyPorts": [443, 80, 22],
    "osIncludes": ["freebsd", "pfsense"],
    "bannerIncludes": ["pfsense", "netgate", "freebsd"],
    "requireSignal": true,
    "weight": 4
  },
  "defaultModuleIds": ["ssh-hardening"]
}
