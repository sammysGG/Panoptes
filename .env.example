# Panoptes configuration. Copy to .env and adjust. install.sh generates one for you.

# ---- Backend ----------------------------------------------------------------
# Port the backend API + Socket.IO listen on.
PORT=4000

# Master secret used to derive the AES key that encrypts stored target
# credentials (SSH keys / passwords). CHANGE THIS to a long random value.
PANOPTES_SECRET_KEY=change-me-to-a-long-random-string

# JWT signing secret (defaults to PANOPTES_SECRET_KEY if unset).
PANOPTES_JWT_SECRET=
PANOPTES_JWT_EXPIRES=12h

# First-run admin account (created only if no users exist yet).
PANOPTES_ADMIN_USER=admin
PANOPTES_ADMIN_PASS=panoptes

# CORS origin for the API. '*' is fine on a trusted lab network; otherwise set
# it to the frontend URL, e.g. http://10.0.0.5:3000
PANOPTES_CORS_ORIGIN=*

# Optional overrides (sensible defaults derive from the repo layout):
# PANOPTES_DB_PATH=/opt/panoptes/backend/data/panoptes.sqlite
# PANOPTES_MODULES_DIR=/opt/panoptes/modules
# PANOPTES_DEFINITIONS_DIR=/opt/panoptes/system-definitions

# ---- Frontend ---------------------------------------------------------------
# Port the Next.js UI listens on.
FRONTEND_PORT=3000

# Optional: hard-pin the API URL the browser calls. If unset, the UI derives it
# from the host you browse to, on PANOPTES_API_PORT below. Leave blank for LAN.
# NEXT_PUBLIC_API_URL=http://10.0.0.5:4000
NEXT_PUBLIC_API_PORT=4000
