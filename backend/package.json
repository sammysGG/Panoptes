{
  "name": "panoptes-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Panoptes backend — network scan, system classification, and SSH-based hardening engine",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "ts-node src/test/run-tests.ts"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "better-sqlite3": "11.10.0",
    "chokidar": "3.6.0",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.2",
    "fast-xml-parser": "4.5.0",
    "jsonwebtoken": "9.0.2",
    "multer": "1.4.5-lts.1",
    "socket.io": "4.8.1",
    "ssh2": "1.16.0",
    "unzipper": "0.12.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/better-sqlite3": "7.6.11",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.2",
    "@types/ssh2": "1.15.1",
    "@types/unzipper": "0.10.10",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.7.2"
  }
}
